{
    "name": "tyhpdef/phpstan-phpstan-phpunit-impl",
    "description": "Implementation package for tyhpdef/phpstan-phpstan-phpunit. Require tyhpdef/phpstan-phpstan-phpunit, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.0.18.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/phpstan-phpstan": "@dev",
                "tyhpdef/phpunit-phpunit": "@dev",
                "tyhpdef/nikic-php-parser": "@dev",
                "tyhpdef/phpstan-phpdoc-parser": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/phpstan-phpstan-phpunit"
        }
    },
    "require": {
        "php": ">=8.2",
        "phpstan/phpstan-phpunit": "2.0.18"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/phpstan-phpstan": "@dev",
        "tyhpdef/phpunit-phpunit": "@dev",
        "tyhpdef/nikic-php-parser": "@dev",
        "tyhpdef/phpstan-phpdoc-parser": "@dev"
    }
}
